# ==========================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND ATELIER (SHOP-2HAND)
# ==========================================

# Cổng khởi chạy máy chủ Backend
PORT=3000

# URL kết nối cơ sở dữ liệu MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shop-2hand?retryWrites=true&w=majority

# URL Frontend Client (dùng cho cấu hình CORS)
CLIENT_URL=http://localhost:3001

# Cloudinary - Lưu trữ và chuyển đổi hình ảnh
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Khóa bí mật mã hóa JWT (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=atelier_super_secret_jwt_key_2026_fashion_secure

# Google OAuth 2.0 (Đăng nhập mạng xã hội)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Dịch vụ gửi Email (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Google Gemini AI API Key (Phục vụ Chatbot tư vấn & Phân tích ảnh ký gửi)
GEMINI_API_KEY=your_gemini_api_key

# Cổng thanh toán VNPay (Sandbox / Production)
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3001/checkout/vnpay_return
